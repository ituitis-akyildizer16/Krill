#compdef krill
# zsh completion: source or add to fpath

_krill() {
  local -a commands
  commands=(
    'ask:ask a question about the current repo'
    'suggest:suggest a shell command'
    'review:summarize the current diff'
    'status:show a repo digest'
    'init:write a default config file'
    'models:list models on the local Ollama server'
    'version:print version and build info'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi

  case $words[2] in
    ask)
      _arguments '(-f --file)'{-f,--file}'[limit context to this file]:file:_files' \
                 '--context-only[print context without calling the model]'
      ;;
    suggest)
      _arguments '--inline[suppress safety warnings]' \
                 '--shell[target shell]:shell:(bash zsh fish powershell)'
      ;;
    review)
      _arguments '--staged[summarize the staged diff]'
      ;;
  esac
}

_krill "$@"